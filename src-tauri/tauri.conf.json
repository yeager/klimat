{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klimat",
  "version": "0.1.7",
  "identifier": "se.klimakontroll.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klimat",
        "width": 360,
        "height": 470,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Styr luftkonditionering från systemfältet",
    "longDescription": "Kompakt styrning av luftkonditionering från systemfältet.",
    "publisher": "Klimat contributors",
    "resources": ["python/adapters.py", "python/dist/"],
    "linux": {
      "appimage": {"files": {"/usr/share/icons/hicolor/scalable/apps/se.klimakontroll.desktop.svg": "icons/klimat.svg"}},
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/se.klimakontroll.desktop.svg": "icons/klimat.svg"
        },
        "desktopTemplate": "icons/klimat.desktop.hbs"
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/se.klimakontroll.desktop.svg": "icons/klimat.svg"
        },
        "desktopTemplate": "icons/klimat.desktop.hbs"
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
